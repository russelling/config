################################################################################

includes:
- ../app_locations.yml
- ../software_paths.yml

################################################################################

# auto discover DCCs for launch
settings.tk-multi-launchapp:
  use_software_entity: true
  hook_before_register_command: "{config}/tk-multi-launchapp/before_register_command.py"
  # Chain default first, then studio NUKE_PATH (camera film-back presets).
  hook_before_app_launch: "{self}/before_app_launch.py:{config}/tk-multi-launchapp/before_app_launch.py"
  location: "@apps.tk-multi-launchapp.location"

# shotgun
settings.tk-multi-launchapp.shotgun:
  use_software_entity: true
  skip_engine_instances: ["tk-nukestudio"]
  hook_before_register_command: "{config}/tk-multi-launchapp/before_register_command.py"
  hook_before_app_launch: "{self}/before_app_launch.py:{config}/tk-multi-launchapp/before_app_launch.py"
  location: "@apps.tk-multi-launchapp.location"

################################################################################

# app-specific launchapp configurations

# hiero
settings.tk-multi-launchapp.hiero:
  engine: tk-hiero
  icon: "{target_engine}/icon_hiero_256.png"
  linux_path: "@path.linux.hiero"
  linux_args: --hiero
  mac_path: "@path.mac.hiero"
  windows_path: "@path.windows.hiero"
  windows_args: --hiero
  menu_name: Hiero
  location: "@apps.tk-multi-launchapp.location"

# mari
settings.tk-multi-launchapp.mari:
  engine: tk-mari
  linux_path: "@path.linux.mari"
  windows_path: "@path.windows.mari"
  menu_name: Mari
  location: "@apps.tk-multi-launchapp.location"

# blender (mac/linux) -- single fixed path per OS, one icon.
# NOTE: this app instance intentionally has no windows_path -- Windows is a
# separate instance below (settings.tk-multi-launchapp.blender_windows) with
# its own "versions" list. A single instance can't have per-platform
# "versions": SingleConfigLauncher applies the same "versions" list to
# whichever platform path it resolves, with no {version} token check, so if
# this instance also carried a windows_path + versions list it would equally
# re-register that many DUPLICATE commands against the fixed mac_path/
# linux_path too (all pointing at the same real binary, just mislabeled by
# version) -- splitting into two instances is what keeps Mac/Linux at one
# real icon each.
settings.tk-multi-launchapp.blender:
  engine: tk-blender
  icon: "{target_engine}/icon_256.png"
  linux_path: "@path.linux.blender"
  mac_path: "@path.mac.blender"
  menu_name: Blender
  # Wires in the same before_app_launch.py hook the base/shotgun instances
  # use, so BLENDER_SYSTEM_SCRIPTS gets pointed at the blender/ tools repo
  # on every launch through this instance (see blender/README.md). Neither
  # of the two blender instances had this set before 2026-09-13 -- Blender
  # launches were the only ones NOT running this hook.
  hook_before_app_launch: "{self}/before_app_launch.py:{config}/tk-multi-launchapp/before_app_launch.py"
  location: "@apps.tk-multi-launchapp.location"

# blender (windows only) -- one launch icon per entry in "versions", each
# with {version} substituted into windows_path/menu_name (see
# software_paths.yml's comment on path.windows.blender) -- e.g. "Blender 5.2"
# -> C:\...\Blender Foundation\Blender 5.2\blender.exe. No linux_path/mac_path
# here on purpose: SingleConfigLauncher skips registering any command for a
# platform whose path setting is unset (empty string), so this instance is a
# no-op on Mac/Linux and the plain instance above is a no-op on Windows (its
# windows_path is unset). No filesystem check happens here either -- a
# version not actually installed on a given machine just fails to launch if
# clicked, rather than not appearing at all. Add a line here the day a new
# 5.x ships.
settings.tk-multi-launchapp.blender_windows:
  engine: tk-blender
  icon: "{target_engine}/icon_256.png"
  windows_path: "@path.windows.blender"
  versions: ["5.2", "5.1", "5.0"]
  menu_name: "Blender {version}"
  # See the plain blender instance above's comment on this hook.
  hook_before_app_launch: "{self}/before_app_launch.py:{config}/tk-multi-launchapp/before_app_launch.py"
  location: "@apps.tk-multi-launchapp.location"

# motionbuilder
settings.tk-multi-launchapp.motionbuilder:
  engine: tk-motionbuilder
  windows_path: "@path.windows.motionbuilder"
  menu_name: MotionBuilder
  location: "@apps.tk-multi-launchapp.location"

# unreal
settings.tk-multi-launchapp.unreal:
  engine: tk-unreal
  icon: "{target_engine}/icon_256.png"
  linux_path: "@path.linux.unreal"
  mac_path: "@path.mac.unreal"
  windows_path: "@path.windows.unreal"
  menu_name: Unreal Engine
  command_name: unreal_engine
  location: "@apps.tk-multi-launchapp.location"
