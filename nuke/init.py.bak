# Nuke startup (loaded via NUKE_PATH from ShotGrid Desktop before_app_launch).
# Registers studio film-back presets for Camera / CameraTracker, and sets the
# studio default OCIO config for brand-new scripts.

import nuke

try:
    import nukescripts.camerapresets as camerapresets
except ImportError:
    camerapresets = None


# ── Default OCIO config for new scripts ──────────────────────────────────────
# STUDIO_COLOR_DEFAULTS_APPLIED_2026_09_17
# knobDefault only changes what a NEW Root node gets when created -- it does
# not touch scripts that already have these knobs saved, so opening an older
# script keeps whatever config it was authored with. The onScriptLoad
# callback below (STUDIO COLOR DEFAULTS section) additionally forces these
# same values onto every script as it opens, new or old, per Mark's request
# 2026-09-16/17.
#
# NOTE 2026-09-17: this comment previously said "ocio://studio-config-latest
# is the same built-in ACES 1.3 Studio config reference qt_bake_oiio.py
# already uses" -- that was true when written but is no longer accurate.
# Verified against the live OCIO install (2.5.2) on 2026-09-17 with
# PyOpenColorIO: the "latest" alias now resolves to
# studio-config-v4.0.0_aces-v2.0_ocio-v2.5 (ACES 2.0), not the ACES 1.3
# config this comment originally described -- it is a floating pointer and
# will keep moving forward as OCIO ships new built-in configs. Mark's call
# (2026-09-17): keep tracking the floating alias here rather than pin to a
# fixed ACES 1.3 config, matching the rest of the pipeline. If that ever
# needs to change, swap _STUDIO_OCIO_CONFIG_PATH below for an explicit
# version, e.g. "ocio://studio-config-v2.2.0_aces-v1.3_ocio-v2.4" (the
# newest build that is genuinely ACES 1.3, confirmed present in the 2.5.2
# built-in registry as of this patch).
_STUDIO_OCIO_CONFIG_PATH = "ocio://studio-config-latest"

nuke.knobDefault("Root.colorManagement", "OCIO")
nuke.knobDefault("Root.OCIO_config", "custom")
nuke.knobDefault("Root.customOCIOConfigPath", _STUDIO_OCIO_CONFIG_PATH)


# ── Studio color defaults enforced on every script open (new or old) ────────
# Mark's request 2026-09-16: every Nuke instance should open on the studio
# OCIO config with the Viewer already showing the Rec.709 ACES Output
# Transform, so the viewer shows the final display-referred look while the
# node graph itself stays in scene-linear ACES -- not just for brand-new
# scripts (knobDefault's normal limit), but for every script as it opens.
#
# This deliberately does NOT use the Viewer's "Input Process" feature.
# Input Process is a separate, optional stage layered on top of whatever
# the Viewer Process (this section) already shows -- it is the right tool
# for previewing a per-shot CDL/show LUT match to dailies (the same grade
# qt_bake_oiio.py bakes into review QTs), not for this base "show me the
# final color" default, which is exactly what the Viewer's own
# viewerProcess knob is for. The per-shot CDL/LUT-in-Nuke piece is still
# open work -- see CLAUDE_INSTRUCTIONS.md's WIP list: ep_shot_cdl /
# ep_shot_lut templates are defined but nothing resolves them yet. Once
# that lands, an Input Process node fed by that lookup is the natural way
# to get a true dailies-matching viewer preview; this section does not
# attempt that.
#
# The exact OCIO display/view names -- and how Nuke concatenates them into
# one viewerProcess knob value -- depend on whatever
# ocio://studio-config-latest resolves to, and per the note above that
# alias has already changed once without anyone deciding it should. So
# rather than hardcode a guessed string, this reads the live choices off a
# real Viewer node's knob and pattern-matches for the Rec.709 SDR Output
# Transform entry, logging loudly (nuke.tprint, visible in the Script
# Editor / terminal) if nothing matches instead of silently leaving the
# default wrong.

_REC709_VIEWER_PROCESS_CACHE = {}


def _find_rec709_viewer_process(config_path):
    """Return the viewerProcess value for the Rec.709 ACES SDR Output
    Transform under the given OCIO config, or None if no single match is
    found. Cached per config path so this only touches the node graph once
    per distinct config per Nuke session."""
    if config_path in _REC709_VIEWER_PROCESS_CACHE:
        return _REC709_VIEWER_PROCESS_CACHE[config_path]

    existing_viewers = nuke.allNodes("Viewer")
    was_modified = nuke.root().modified()
    tmp_viewer = None
    try:
        viewer = existing_viewers[0] if existing_viewers else nuke.nodes.Viewer()
        if not existing_viewers:
            tmp_viewer = viewer
        try:
            choices = list(viewer["viewerProcess"].values())
        except Exception as exc:
            nuke.tprint(
                "[studio-color-defaults] Could not read viewerProcess "
                "choices for %s: %s" % (config_path, exc)
            )
            _REC709_VIEWER_PROCESS_CACHE[config_path] = None
            return None
    finally:
        if tmp_viewer is not None:
            nuke.delete(tmp_viewer)
        nuke.root().setModified(was_modified)

    candidates = [
        c for c in choices
        if "Rec.1886 Rec.709" in c
        and "Rec.709)" in c
        and "Un-tone-mapped" not in c
        and "Raw" not in c
        and "colorimetric" not in c
    ]
    if not candidates:
        nuke.tprint(
            "[studio-color-defaults] WARNING: no viewerProcess choice "
            "matched the Rec.709 SDR Output Transform for %s. Leaving "
            "Viewer default untouched. Available choices: %s"
            % (config_path, choices)
        )
        result = None
    else:
        if len(candidates) > 1:
            nuke.tprint(
                "[studio-color-defaults] WARNING: %d viewerProcess choices "
                "matched Rec.709 SDR for %s, using the first: %s"
                % (len(candidates), config_path, candidates)
            )
        result = candidates[0]
        nuke.tprint("[studio-color-defaults] Viewer default -> %r" % (result,))

    _REC709_VIEWER_PROCESS_CACHE[config_path] = result
    return result


def _apply_studio_color_defaults():
    root = nuke.root()

    for knob_name, target_value in (
        ("colorManagement", "OCIO"),
        ("OCIO_config", "custom"),
        ("customOCIOConfigPath", _STUDIO_OCIO_CONFIG_PATH),
    ):
        knob = root[knob_name]
        current_value = knob.value()
        if current_value != target_value:
            nuke.tprint(
                "[studio-color-defaults] Root.%s: %r -> %r"
                % (knob_name, current_value, target_value)
            )
            knob.setValue(target_value)

    viewer_process = _find_rec709_viewer_process(_STUDIO_OCIO_CONFIG_PATH)
    if viewer_process is None:
        return

    nuke.knobDefault("Viewer.viewerProcess", viewer_process)
    for viewer in nuke.allNodes("Viewer"):
        knob = viewer["viewerProcess"]
        if knob.value() != viewer_process:
            nuke.tprint(
                "[studio-color-defaults] %s.viewerProcess: %r -> %r"
                % (viewer.name(), knob.value(), viewer_process)
            )
            knob.setValue(viewer_process)


nuke.addOnScriptLoad(_apply_studio_color_defaults)

# (label, haperture_mm, vaperture_mm)
# Labels follow Nuke's built-in "Vendor/Model …" naming.
_STUDIO_FILM_BACKS = (
    # ARRI ALEXA 35 — sensor / recorded formats (mm)
    # Open Gate 4.6K 3:2: 27.99 x 19.22 (ARRI)
    ("Arri/Alexa 35 Open Gate", 27.99, 19.22),
    # 4.6K 16:9: 27.99 x 15.75 (ARRI)
    ("Arri/Alexa 35 16:9", 27.99, 15.75),
    # Nikon ZR — full-frame FX CMOS 35.9 x 23.9 (Nikon)
    ("Nikon/ZR", 35.9, 23.9),
)


def _register_studio_film_backs():
    if camerapresets is None:
        return
    existing = set(camerapresets.getLabels())
    for label, haperture, vaperture in _STUDIO_FILM_BACKS:
        if label in existing:
            continue
        camerapresets.addPreset(label, haperture, vaperture)
        existing.add(label)


_register_studio_film_backs()
