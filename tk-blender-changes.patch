+# blender
+# NOTE: action names below assume a default tk-multi-loader2 "import" action
+# hook for Blender (link/append). Verify against the actual tk-blender +
+# tk-multi-loader2 hook shipped once installed, and adjust action names if
+# the studio's Blender actions hook uses different identifiers.
+settings.tk-multi-loader2.blender:
+  action_mappings:
+    Blender Scene: [import]
+    Image: [import]
+    Rendered Image: [import]
+    Texture: [import]
+  entities:
